{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DSF Scheduler Interface",
  "description": "Input/output contract for DSF scheduler implementations (built-in and user-defined).",

  "definitions": {
    "SchedulerInput": {
      "type": "object",
      "required": ["dag", "clusterState"],
      "properties": {
        "dag": {
          "type": "object",
          "required": ["name", "tasks"],
          "properties": {
            "name": { "type": "string" },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "dependencies": { "type": "array", "items": { "type": "string" } },
                  "runtime": { "type": "number", "description": "Expected runtime in seconds" },
                  "dataSize": { "type": "number", "description": "Output data size in bytes" },
                  "resources": {
                    "type": "object",
                    "properties": {
                      "cpu": { "type": "string" },
                      "memory": { "type": "string" }
                    }
                  },
                  "constraints": {
                    "type": "object",
                    "properties": {
                      "nodeNames": { "type": "array", "items": { "type": "string" } }
                    }
                  }
                }
              }
            }
          }
        },
        "clusterState": {
          "type": "object",
          "required": ["nodes"],
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["name"],
                "properties": {
                  "name": { "type": "string" },
                  "allocatableCPU": { "type": "number", "description": "Allocatable CPU in millicores" },
                  "allocatableMemory": { "type": "number", "description": "Allocatable memory in bytes" },
                  "availableCPU": { "type": "number", "description": "Currently available CPU in millicores" },
                  "availableMemory": { "type": "number", "description": "Currently available memory in bytes" },
                  "ready": { "type": "boolean" }
                }
              }
            },
            "bandwidth": {
              "type": "array",
              "description": "Pairwise bandwidth measurements between nodes (bytes/sec).",
              "items": {
                "type": "object",
                "required": ["from", "to", "bytesPerSec"],
                "properties": {
                  "from": { "type": "string" },
                  "to": { "type": "string" },
                  "bytesPerSec": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },

    "SchedulerOutput": {
      "type": "object",
      "required": ["assignments"],
      "properties": {
        "assignments": {
          "type": "array",
          "description": "One entry per task, mapping task name to target node.",
          "items": {
            "type": "object",
            "required": ["task", "node"],
            "properties": {
              "task": { "type": "string" },
              "node": { "type": "string" },
              "estimatedStart": { "type": "number", "description": "Estimated start time in seconds from DAG start" },
              "estimatedFinish": { "type": "number", "description": "Estimated finish time in seconds from DAG start" }
            }
          }
        },
        "estimatedMakespan": { "type": "number", "description": "Estimated total makespan in seconds" }
      }
    }
  },

  "oneOf": [
    { "$ref": "#/definitions/SchedulerInput" },
    { "$ref": "#/definitions/SchedulerOutput" }
  ]
}
